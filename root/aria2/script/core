#!/usr/bin/env bash

GET_BASE_PATH() {
    # Aria2下载目录
    DOWNLOAD_PATH="/downloads"
    # 种子备份目录
    BAK_TORRENT_DIR="/config/backup-torrent"
    # 日志、配置文件保存路径
    SCRIPT_CONF="/config/文件过滤.conf"
    CF_LOG="/config/logs/文件过滤日志.log"
    MOVE_LOG="/config/logs/move.log"
    DELETE_LOG="/config/logs/delete.log"
    RECYCLE_LOG="/config/logs/recycle.log"
}

# ========================GET_TARGET_PATH==============================

COMPLETED_PATH() {
    # 完成任务后转移
    TARGET_DIR="${DOWNLOAD_PATH}/completed"
}

RECYCLE_PATH() {
    # 回收站
    TARGET_DIR="${DOWNLOAD_PATH}/recycle"
}

# ============================颜色==============================

RED_FONT_PREFIX="\033[31m"
LIGHT_GREEN_FONT_PREFIX="\033[1;32m"
YELLOW_FONT_PREFIX="\033[1;33m"
LIGHT_PURPLE_FONT_PREFIX="\033[1;35m"
FONT_COLOR_SUFFIX="\033[0m"
INFO="[${LIGHT_GREEN_FONT_PREFIX}INFO${FONT_COLOR_SUFFIX}]"
# shellcheck disable=SC2034
ERROR="[${RED_FONT_PREFIX}ERROR${FONT_COLOR_SUFFIX}]"
# shellcheck disable=SC2034
# WARNING 日志标签。
WARNING="[${YELLOW_FONT_PREFIX}WARNING${FONT_COLOR_SUFFIX}]"

. "$(dirname "$0")/log_common"

# ==========================任务信息===============================

TASK_INFO() {
    echo -e "
-------------------------- [${YELLOW_FONT_PREFIX} 任务信息 ${TASK_TYPE} ${FONT_COLOR_SUFFIX}] --------------------------
${LIGHT_PURPLE_FONT_PREFIX}根下载路径:${FONT_COLOR_SUFFIX} ${DOWNLOAD_PATH}
${LIGHT_PURPLE_FONT_PREFIX}任务位置:${FONT_COLOR_SUFFIX} ${SOURCE_PATH}
${LIGHT_PURPLE_FONT_PREFIX}首个文件位置:${FONT_COLOR_SUFFIX} ${FILE_PATH}
${LIGHT_PURPLE_FONT_PREFIX}任务文件数量:${FONT_COLOR_SUFFIX} ${FILE_NUM}
${LIGHT_PURPLE_FONT_PREFIX}移动至目标文件夹:${FONT_COLOR_SUFFIX} ${TARGET_PATH}
-----------------------------------------------------------------------------------------------------------------------
"
}

DELETE_INFO() {
    echo -e "
-------------------------- [${YELLOW_FONT_PREFIX} 任务信息 ${TASK_TYPE} ${FONT_COLOR_SUFFIX}] --------------------------
${LIGHT_PURPLE_FONT_PREFIX}根下载路径:${FONT_COLOR_SUFFIX} ${DOWNLOAD_PATH}
${LIGHT_PURPLE_FONT_PREFIX}任务位置:${FONT_COLOR_SUFFIX} ${SOURCE_PATH}
${LIGHT_PURPLE_FONT_PREFIX}首个文件位置:${FONT_COLOR_SUFFIX} ${FILE_PATH}
${LIGHT_PURPLE_FONT_PREFIX}任务文件数量:${FONT_COLOR_SUFFIX} ${FILE_NUM}
-----------------------------------------------------------------------------------------------------------------------
"
}

# 将当前 SOURCE_PATH 移动到 move-failed 目录并记录结果日志。
# 入参消息需提前格式化，以保持原有日志文案不变。
MOVE_TO_FAIL_DIR() {
    local success_message="$1"
    local success_log_message="$2"
    local fail_dir="${DOWNLOAD_PATH}/move-failed"

    mkdir -p "${fail_dir}"
    mv -f "${SOURCE_PATH}" "${fail_dir}"
    local move_fail_exit_code=$?
    if [ "${move_fail_exit_code}" -eq 0 ]; then
        echo -e "${success_message}"
        APPEND_LOG "${MOVE_LOG}" "${success_log_message}"
    else
        LOG_ERROR "移动到 ${fail_dir} 依然失败: ${SOURCE_PATH}"
        LOG_FILE_ERROR "${MOVE_LOG}" "移动到 ${fail_dir} 依然失败: ${SOURCE_PATH}"
    fi
}

# =============================读取conf文件设置=============================

LOAD_SCRIPT_CONF() {
    MIN_SIZE="$(grep '^min-size=' "${SCRIPT_CONF}" | cut -d= -f2-)"
    INCLUDE_FILE="$(grep '^include-file=' "${SCRIPT_CONF}" | cut -d= -f2-)"
    EXCLUDE_FILE="$(grep '^exclude-file=' "${SCRIPT_CONF}" | cut -d= -f2-)"
    KEYWORD_FILE="$(grep '^keyword-file=' "${SCRIPT_CONF}" | cut -d= -f2-)"
    INCLUDE_FILE_REGEX="$(grep '^include-file-regex=' "${SCRIPT_CONF}" | cut -d= -f2-)"
    EXCLUDE_FILE_REGEX="$(grep '^exclude-file-regex=' "${SCRIPT_CONF}" | cut -d= -f2-)"
}

NORMALIZE_FIND_SIZE() {
    local raw_size="$1"
    if [[ "${raw_size}" =~ ^([0-9]+)([A-Za-z])$ ]]; then
        printf '%s%s' "${BASH_REMATCH[1]}" "$(echo "${BASH_REMATCH[2]}" | tr '[:upper:]' '[:lower:]')"
    else
        printf '%s' "${raw_size}"
    fi
}

DELETE_EXCLUDE_FILE() {
    if [[ ${FILE_NUM} -gt 1 ]] && [ "${SOURCE_PATH}" != "${DOWNLOAD_PATH}" ] && [[ -n ${MIN_SIZE} || -n ${INCLUDE_FILE} || -n ${EXCLUDE_FILE} || -n ${KEYWORD_FILE} || -n ${EXCLUDE_FILE_REGEX} || -n ${INCLUDE_FILE_REGEX} ]]; then
        local normalized_min_size
        normalized_min_size="$(NORMALIZE_FIND_SIZE "${MIN_SIZE}")"
        LOG_INFO "删除不需要的文件..."
        [[ -n ${MIN_SIZE} ]] && find "${SOURCE_PATH}" -type f -size -"${normalized_min_size}" -print0 | xargs -0r rm -vf | tee -a "${CF_LOG}"
        [[ -n ${EXCLUDE_FILE} ]] && find "${SOURCE_PATH}" -type f -regextype posix-extended -iregex ".*\.(${EXCLUDE_FILE})" -print0 | xargs -0r rm -vf | tee -a "${CF_LOG}"
        [[ -n ${KEYWORD_FILE} ]] && find "${SOURCE_PATH}" -type f -regextype posix-extended -iregex ".*(${KEYWORD_FILE}).*" -print0 | xargs -0r rm -vf | tee -a "${CF_LOG}"
        [[ -n ${INCLUDE_FILE} ]] && find "${SOURCE_PATH}" -type f -regextype posix-extended ! -iregex ".*\.(${INCLUDE_FILE})" -print0 | xargs -0r rm -vf | tee -a "${CF_LOG}"
        [[ -n ${EXCLUDE_FILE_REGEX} ]] && find "${SOURCE_PATH}" -type f -regextype posix-extended -iregex "${EXCLUDE_FILE_REGEX}" -print0 | xargs -0r rm -vf | tee -a "${CF_LOG}"
        [[ -n ${INCLUDE_FILE_REGEX} ]] && find "${SOURCE_PATH}" -type f -regextype posix-extended ! -iregex "${INCLUDE_FILE_REGEX}" -print0 | xargs -0r rm -vf | tee -a "${CF_LOG}"
    fi
}

# =============================删除.ARIA2=============================

RM_ARIA2() {
    if [ -e "${SOURCE_PATH}.aria2" ]; then
        rm -f "${SOURCE_PATH}.aria2"
        LOG_INFO "已删除文件: ${SOURCE_PATH}.aria2"
    fi
}

# =============================删除空文件夹=============================

DELETE_EMPTY_DIR() {
    if [ "${DET}" = "true" ]; then
        LOG_INFO "删除任务中空的文件夹 ..."
        find "${SOURCE_PATH}" -depth -type d -empty -exec rm -vrf {} \;
    fi
}

# =============================内容过滤=============================

CLEAN_UP() {
    RM_ARIA2
    if [ "${CF}" = "true" ] && [ "${FILE_NUM}" -gt 1 ] && [ "${SOURCE_PATH}" != "${DOWNLOAD_PATH}" ]; then
        echo -e "$(DATE_TIME) ${INFO} 被过滤文件的任务路径: ${SOURCE_PATH}" | tee -a "${CF_LOG}"
        LOAD_SCRIPT_CONF
        DELETE_EXCLUDE_FILE
        DELETE_EMPTY_DIR
    fi
}

# =============================移动文件=============================

MOVE_FILE() {
    # DOWNLOAD_DIR = DOWNLOAD_PATH 表示在根目录下载的单文件，`dmof` 模式下不进行移动。
    if [ "${MOVE}" = "false" ]; then
        RM_ARIA2
        return
    elif [ "${MOVE}" = "dmof" ] && [ "${DOWNLOAD_DIR}" = "${DOWNLOAD_PATH}" ] && [ "${FILE_NUM}" -eq 1 ]; then
        RM_ARIA2
        return
    elif [ "${MOVE}" = "true" ] || [ "${MOVE}" = "dmof" ]; then
        TASK_TYPE=": 移动任务文件"
        TASK_INFO
        CLEAN_UP
        LOG_INFO "开始移动该任务文件到: ${LIGHT_GREEN_FONT_PREFIX}${TARGET_PATH}${FONT_COLOR_SUFFIX}"
        mkdir -p "${TARGET_PATH}"

        # === 新增功能：移动前检查磁盘空间（开始）===
        # 使用 `stat -c %d` 获取设备 ID，Docker 运行环境通常为 Linux。
        SOURCE_DEVICE=$(stat -c %d "${SOURCE_PATH}")
        TARGET_DEVICE=$(stat -c %d "${TARGET_PATH}")

        # 当源和目标的设备号不同时，说明是跨磁盘移动，需要检查空间
        if [ "${SOURCE_DEVICE}" != "${TARGET_DEVICE}" ]; then
            LOG_INFO "检测到跨磁盘移动，正在检查目标磁盘空间..."
            # 获取源文件/目录所需的空间大小（单位: 字节）
            REQUIRED_SPACE=$(du -sb "${SOURCE_PATH}" | awk '{print $1}')
            # 获取目标路径可用空间（单位：字节），使用 --output 提高兼容性。
            AVAILABLE_SPACE=$(df --output=avail -B1 "${TARGET_PATH}" | sed '1d')

            if (( AVAILABLE_SPACE < REQUIRED_SPACE )); then
                # 为了日志与输出可读性，转换为 GB。
                REQUIRED_GB=$(awk "BEGIN {printf \"%.2f\", ${REQUIRED_SPACE}/1024/1024/1024}")
                AVAILABLE_GB=$(awk "BEGIN {printf \"%.2f\", ${AVAILABLE_SPACE}/1024/1024/1024}")
                LOG_ERROR "目标磁盘空间不足！无法移动文件。"
                LOG_ERROR "所需空间: ${REQUIRED_GB} GB, 目标可用空间: ${AVAILABLE_GB} GB."
                LOG_FILE_ERROR "${MOVE_LOG}" "目标磁盘空间不足，移动失败。所需空间:${REQUIRED_GB} GB, 可用空间:${AVAILABLE_GB} GB. 源:${SOURCE_PATH} -> 目标:${TARGET_PATH}"
                
                # 空间不足，直接将任务移动到失败文件夹
                FAIL_DIR="${DOWNLOAD_PATH}/move-failed"
                LOG_WARNING "尝试将任务移动到: ${FAIL_DIR}"
                MOVE_TO_FAIL_DIR \
                    "$(DATE_TIME) ${INFO} 因目标磁盘空间不足，已将文件移动至: ${SOURCE_PATH} -> ${FAIL_DIR}" \
                    "$(DATE_TIME) [INFO] 因目标磁盘空间不足，已将文件移动至: ${SOURCE_PATH} -> ${FAIL_DIR}"
                
                # 终止后续的正常移动流程
                return 1
            fi
            LOG_INFO "目标磁盘空间充足。"
        else
            LOG_INFO "检测为同磁盘移动，无需检查空间。"
        fi
        # === 新增功能：移动前检查磁盘空间（结束）===

        mv -f "${SOURCE_PATH}" "${TARGET_PATH}"
        MOVE_EXIT_CODE=$?
        if [ "${MOVE_EXIT_CODE}" -eq 0 ]; then
            LOG_INFO "已移动文件至目标文件夹: ${SOURCE_PATH} -> ${TARGET_PATH}"
            LOG_FILE_INFO "${MOVE_LOG}" "已移动文件至目标文件夹: ${SOURCE_PATH} -> ${TARGET_PATH}"
        else
            LOG_ERROR "文件移动失败: ${SOURCE_PATH}"
            LOG_FILE_ERROR "${MOVE_LOG}" "文件移动失败: ${SOURCE_PATH}"
            
            # 移动失败后（非空间不足原因）转移至 `/downloads/move-failed`。
            FAIL_DIR="${DOWNLOAD_PATH}/move-failed"
            MOVE_TO_FAIL_DIR \
                "$(DATE_TIME) ${INFO} 已将文件移动至: ${SOURCE_PATH} -> ${FAIL_DIR}" \
                "$(DATE_TIME) [INFO] 已将文件移动至: ${SOURCE_PATH} -> ${FAIL_DIR}"
        fi
    fi
}

# =============================删除文件=============================

DELETE_FILE() {
    TASK_TYPE=": 删除任务文件"
    DELETE_INFO
    LOG_INFO "下载已停止，开始删除文件..."
    rm -rf "${SOURCE_PATH}"
    DELETE_EXIT_CODE=$?
    if [ "${DELETE_EXIT_CODE}" -eq 0 ]; then
        LOG_INFO "已删除文件: ${SOURCE_PATH}"
        LOG_FILE_INFO "${DELETE_LOG}" "文件删除成功: ${SOURCE_PATH}"
    else
        LOG_ERROR "删除失败: ${SOURCE_PATH}"
        LOG_FILE_ERROR "${DELETE_LOG}" "文件删除失败: ${SOURCE_PATH}"
    fi
}

# =============================回收站=============================

MOVE_RECYCLE() {
    TASK_TYPE=": 移动任务文件至回收站"
    TASK_INFO
    LOG_INFO "开始移动已下载的任务至回收站 ${LIGHT_GREEN_FONT_PREFIX}${TARGET_PATH}${FONT_COLOR_SUFFIX}"
    mkdir -p "${TARGET_PATH}"
    mv -f "${SOURCE_PATH}" "${TARGET_PATH}"
    RECYCLE_EXIT_CODE=$?
    if [ "${RECYCLE_EXIT_CODE}" -eq 0 ]; then
        LOG_INFO "已移至回收站: ${SOURCE_PATH} -> ${TARGET_PATH}"
        LOG_FILE_INFO "${RECYCLE_LOG}" "成功移动文件到回收站: ${SOURCE_PATH} -> ${TARGET_PATH}"
    else
        LOG_ERROR "移动文件到回收站失败: ${SOURCE_PATH}"
        rm -rf "${SOURCE_PATH}"
        local delete_exit_code=$?
        if [ "${delete_exit_code}" -eq 0 ]; then
            LOG_INFO "已删除文件: ${SOURCE_PATH}"
        else
            LOG_ERROR "删除失败: ${SOURCE_PATH}"
        fi
        LOG_FILE_ERROR "${RECYCLE_LOG}" "移动文件到回收站失败: ${SOURCE_PATH}"
    fi
}

# =============================处理种子文件=============================

HANDLE_TORRENT() {
    if [ "${TOR}" = "retain" ]; then
        return
    elif [ "${TOR}" = "delete" ]; then
        LOG_INFO "已删除种子文件: ${TORRENT_FILE}"
        rm -f "${TORRENT_FILE}"
        return
    elif [ "${TOR}" = "rename" ]; then
        LOG_INFO "已删除种子文件: ${TORRENT_FILE}"
        mv -f "${TORRENT_FILE}" "${DOWNLOAD_DIR}/${TASK_NAME}.torrent"
    elif [ "${TOR}" = "backup" ]; then
        LOG_INFO "备份种子文件: ${TORRENT_FILE}"
        mv -vf "${TORRENT_FILE}" "${BAK_TORRENT_DIR}"
    elif [ "${TOR}" = "backup-rename" ]; then
        LOG_INFO "重命名并备份种子文件: ${BAK_TORRENT_DIR}/${TASK_NAME}.torrent"
        mv -f "${TORRENT_FILE}" "${BAK_TORRENT_DIR}/${TASK_NAME}.torrent"
    fi
}

CHECK_TORRENT() {
    if [ -e "${TORRENT_FILE}" ]; then
        HANDLE_TORRENT
    fi
}

# =============================判断文件路径=============================

GET_TARGET_PATH() {
    RELATIVE_PATH="${SOURCE_PATH#"${DOWNLOAD_PATH}/"}"
    TARGET_PATH="${TARGET_DIR}/$(dirname "${RELATIVE_PATH}")"
    # 出现 `//` 说明路径获取失败，设置错误状态以阻止后续流程继续执行。
    if [ "${TARGET_PATH}" == "${TARGET_DIR}//" ]; then
        # shellcheck disable=SC2034
        GET_PATH_INFO="error"
        return
    # /downloads根目录下载会出现 /.
    elif [ "${TARGET_PATH}" = "${TARGET_DIR}/." ]; then
        TARGET_PATH="${TARGET_DIR}"
    fi
}

GET_FINAL_PATH() { 
    if [ -z "${FILE_PATH}" ]; then
        return
    # 判断是否为在文件夹内的单文件BT下载任务（会出现移动文件后文件夹保留的情况），如果是则降级到目录
    # 修复Mac下能够正常运行，Linux下失败的问题
    elif [ "${FILE_NUM}" -gt 1 ] || [ "$(dirname "${FILE_PATH}")" != "${DOWNLOAD_DIR}" ]; then
        RELATIVE_PATH="${FILE_PATH#"${DOWNLOAD_DIR}/"}"
        TASK_NAME="${RELATIVE_PATH%%/*}"
        SOURCE_PATH="${DOWNLOAD_DIR}/${TASK_NAME}"
        GET_TARGET_PATH
        # shellcheck disable=SC2034
        COMPLETED_DIR="${TARGET_PATH}/${TASK_NAME}"
        return
    elif [ "${FILE_NUM}" -eq 1 ]; then
        SOURCE_PATH="${FILE_PATH}"
        RELATIVE_PATH="${FILE_PATH#"${DOWNLOAD_DIR}/"}"
        # 单文件，去除.
        TASK_NAME="${RELATIVE_PATH##*/}"
        TASK_NAME="${TASK_NAME%.*}"
        GET_TARGET_PATH
        return
    fi
}
