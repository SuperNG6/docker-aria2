#!/usr/bin/with-contenv bash
# aria2c 服务启动脚本（由 s6-overlay 管理，崩溃后自动重启）
# s6-setuidgid abc：以非 root 的 abc 用户运行，避免下载文件权限问题
# 用数组装命令行参数：变量统一加引号，SECRET 含空格或特殊字符也能完整传入
# SECRET 为空时不带 --rpc-secret 参数（aria2c 视为不启用密钥）

ARGS=(
    s6-setuidgid abc aria2c
    --conf-path=/config/aria2.conf
    --disk-cache="$CACHE"
    --quiet="$QUIET"
)

[ -n "$SECRET" ] && ARGS+=(--rpc-secret="$SECRET")

exec "${ARGS[@]}" \
    > /dev/stdout \
    2> /dev/stderr

echo 'Exiting aria2'
