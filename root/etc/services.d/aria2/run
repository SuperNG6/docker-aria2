#!/usr/bin/with-contenv bash

RPC_SECRET_ARGS=()
if [[ -n "${SECRET}" ]]; then
  RPC_SECRET_ARGS=(--rpc-secret="${SECRET}")
fi

exec \
	s6-setuidgid abc aria2c \
	    --conf-path=/config/aria2.conf \
	    "${RPC_SECRET_ARGS[@]}" \
	    --disk-cache="${CACHE}" \
	    --quiet="${QUIET}" \
  > /dev/stdout \
  2> /dev/stderr
