#!/usr/bin/with-contenv bash
# aria2b 服务启动脚本（由 s6-overlay 管理）
# aria2b 是一个 BT 流量优化代理，仅在 a2b 变体（VARIANT=a2b）中安装
# A2B=true 时正常启动；A2B!=true 时执行 s6-svc -d . 让 s6 停止监控本服务，
# 避免 s6 因进程不存在而无限重启（标准的 s6-overlay v2 服务禁用方式）

if [ "${A2B}" != "true" ]; then
    echo "信息：Aria2B 功能未启用（A2B!=true）"
    # 通知 s6 停止监控本服务（-d = down），防止 s6 因 exec 退出而反复重启
    exec s6-svc -d .
fi

echo "信息：Aria2B 功能已启用。"
# aria2b 需要 aria2c 的 RPC 接口已就绪，poll 至多 30 秒直至 RPC 响应
# 早期固定 sleep 10 在 RPC 慢启动时仍可能抢跑；改 poll 既快又稳
# payload 用 jq 构造：SECRET 含 " \ 换行等特殊字符也能安全转义，与 lib/rpc.sh 风格统一
echo "信息：等待 Aria2c RPC 就绪 ..."
PROBE_PAYLOAD=$(jq -nc \
    --arg secret "${SECRET}" \
    '{jsonrpc:"2.0",id:"a2b-wait",method:"aria2.getVersion",
      params:(if $secret == "" then [] else ["token:" + $secret] end)}')
for i in $(seq 1 30); do
    if curl -fsS --max-time 1 "http://127.0.0.1:${PORT}/jsonrpc" \
        -H 'Content-Type: application/json' \
        -d "${PROBE_PAYLOAD}" \
        >/dev/null 2>&1; then
        echo "信息：Aria2c RPC 已就绪（${i}s）"
        break
    fi
    sleep 1
done

# 用数组装参数：A2B_DISABLE_LOG 控制是否丢弃输出，启停两路径共享同一份参数
ARGS=(
    aria2b
    -c "/config/aria2.conf"
    -u "http://127.0.0.1:${PORT}/jsonrpc"
    -s "${SECRET}"
)

if [ "${A2B_DISABLE_LOG}" = "true" ]; then
    exec "${ARGS[@]}" > /dev/null 2>&1
else
    exec "${ARGS[@]}"
fi
