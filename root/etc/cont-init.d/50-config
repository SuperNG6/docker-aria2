#!/usr/bin/with-contenv bash
# 容器启动第五步：启动 WebUI（AriaNg）
# WEBUI=true 时用 darkhttpd 在 WEBUI_PORT 端口托管 /www 目录下的静态页面
# darkhttpd 以守护进程模式运行（--daemon），不阻塞 s6 的后续初始化
# 启动失败（端口冲突、目录不存在等）时打印错误，方便用户调试

if [ "$WEBUI" = "true" ]; then
    if darkhttpd /www --index index.html --port "${WEBUI_PORT}" --daemon; then
        echo "信息：WebUI 已启动 (端口 ${WEBUI_PORT})"
    else
        echo "错误：WebUI 启动失败（exit=$?）。检查端口 ${WEBUI_PORT} 是否被占用、/www 是否存在" >&2
    fi
fi
