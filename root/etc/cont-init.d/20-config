#!/usr/bin/with-contenv bash
# 容器启动第二步：初始化配置文件和目录结构
# 首次启动时将内置默认配置复制到 /config（持久化卷）
# 后续启动时通过 SED_CONF 把用户已有配置合并到新模板（升级时保留旧值）

# 创建必要的目录（卷挂载后可能不存在子目录）
mkdir -p \
    /config/ssl \
    /config/logs \
    /config/backup-torrent \
    /downloads/completed \
    /downloads/recycle

# aria2.conf：首次启动复制默认；已存在则保留用户配置
[ -e /config/aria2.conf ] || cp /aria2/conf/aria2.conf.default /config/aria2.conf

# setting.conf：首次启动复制默认 + 吸收 env var 作为种子值；已存在则合并到新模板（保留旧值 + 引入新键）
# env var 仅在首次启动时一次性吸收；后续以 /config/setting.conf 为准
# 注：首次启动 cp 后的文件就是新模板本身，无需再做一次 SED_CONF
if [ ! -e /config/setting.conf ]; then
    cp /aria2/conf/setting.conf /config/setting.conf
    . /aria2/scripts/lib/config.sh
    SEED_ENV_TO_SETTING_CONF
else
    . /aria2/scripts/lib/config.sh
    SED_CONF
fi

# 文件过滤.conf：首次启动复制默认
[ -e /config/文件过滤.conf ] || cp /aria2/conf/文件过滤.conf /config/文件过滤.conf

# 运行时数据文件：aria2 会话与 DHT 路由表
[ -e /config/aria2.session ] || touch /config/aria2.session
[ -e /config/dht.dat ]       || touch /config/dht.dat

# 2021.03.15 变更：日志文件从 /config/ 根目录迁到 /config/logs/
if [ -e /config/move.log ] || [ -e /config/recycle.log ] || [ -e /config/delete.log ] || [ -e /config/文件过滤日志.log ]; then
    mv /config/*.log /config/logs/
fi

# 各功能日志文件按需创建（缺一即补）
for log in move.log recycle.log delete.log 文件过滤日志.log; do
    [ -e "/config/logs/${log}" ] || touch "/config/logs/${log}"
done
