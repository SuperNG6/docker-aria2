#!/usr/bin/with-contenv bash
# 容器启动第三步：将环境变量应用到 aria2.conf，并配置定时任务
# 所有可通过环境变量控制的 aria2 参数都在这里写入配置文件
# 统一用 ^\(key=\).* 锚定模式：只替换值，永不误匹配注释行

ARIA2_CONF=/config/aria2.conf

# 写入一个由项目接管的 aria2 选项：已有行替换值，缺行时追加。
# 用户换用其他项目的 aria2.conf 时常缺少或注释掉 on-download-* 等行；
# 只替换不追加会让事件 hook 静默失效，下载完成后既不处理文件也没有任何日志。
SET_ARIA2_OPTION() {
    local key=$1 value=$2 escaped
    # 环境变量被显式置空时保留文件原值（或 aria2 默认值），写入空值会让 aria2c 无法启动
    [ -n "${value}" ] || return 0
    if grep -q "^${key}=" "${ARIA2_CONF}"; then
        # sed replacement 中的 \、& 和分隔符 @ 有特殊含义，写入前转义
        escaped=$(printf '%s' "${value}" | sed -e 's/[\\&@]/\\&/g')
        sed -i "s@^\(${key}=\).*@\1${escaped}@" "${ARIA2_CONF}"
    else
        # 文件末尾缺换行时先补一个，避免新行接在最后一行后面
        [ -z "$(tail -c 1 "${ARIA2_CONF}")" ] || echo >> "${ARIA2_CONF}"
        printf '%s=%s\n' "${key}" "${value}" >> "${ARIA2_CONF}"
    fi
}

# 写入下载事件钩子脚本路径 + RPC/BT 端口
SET_ARIA2_OPTION on-download-stop /aria2/scripts/stop.sh
SET_ARIA2_OPTION on-download-complete /aria2/scripts/completed.sh
SET_ARIA2_OPTION on-download-pause /aria2/scripts/pause.sh
SET_ARIA2_OPTION on-download-start /aria2/scripts/start.sh
SET_ARIA2_OPTION rpc-listen-port "${PORT}"
SET_ARIA2_OPTION dht-listen-port "${BTPORT}"
SET_ARIA2_OPTION listen-port "${BTPORT}"

# SMD=true：保存磁力链接的元数据（.torrent 文件），方便种子文件备份功能使用
[ "$SMD" = "true" ] && SMD_VAL=true || SMD_VAL=false
SET_ARIA2_OPTION bt-save-metadata "${SMD_VAL}"

# FA 环境变量控制文件预分配方式（影响下载初始化速度和磁盘性能）
# falloc：快速预分配（推荐 ext4/xfs），trunc：截断预分配，prealloc：慢速预分配，none：不预分配
# 未识别（含 FA 未设置）一律回退到 falloc，与 aria2.conf 默认值保持一致；
# 早期回退到 none 是 bug，会把新容器默认的 falloc 改成 none
case "$FA" in
    falloc|trunc|prealloc|none) FA_VAL="$FA" ;;
    *)                          FA_VAL=falloc ;;
esac
SET_ARIA2_OPTION file-allocation "${FA_VAL}"

# UT=true：容器启动时立即更新 BT tracker 列表（写入 aria2.conf 文件，aria2c 启动后生效）
[ "$UT" = "true" ] && bash /aria2/scripts/lib/tracker.sh

# RUT=true：启用定时（每日凌晨 5 点）通过 RPC 动态更新 tracker（无需重启）
# 无论 RUT 值如何，都启动 crond 以保证系统维护定时任务（hourly/daily/weekly/monthly）正常运行
if [ "$RUT" = "true" ]; then
    cp /aria2/conf/rpc-tracker1 /etc/crontabs/root  # 含系统 cron + tracker 更新任务
else
    cp /aria2/conf/rpc-tracker0 /etc/crontabs/root  # 仅含系统 cron 任务
fi
/usr/sbin/crond
