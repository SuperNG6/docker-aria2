#!/usr/bin/with-contenv bash
# 容器启动第四步：设置文件权限，并配置 aria2b 定时重启（仅 a2b 变体）
# 必须在所有配置文件创建完成后执行（依赖 20-config、30-config 已完成）

# 将配置目录、WebUI 目录、下载目录的所有权移交给 abc 用户
# aria2c 进程以 abc 身份运行（services.d/aria2/run 中的 s6-setuidgid abc）
chown -R abc:abc \
    /config \
    /www \
    /downloads

# 递归赋予 /aria2/scripts 下所有 .sh 文件可执行权限（事件钩子需要被 aria2 直接执行）
find /aria2/scripts -name "*.sh" -exec chmod a+x {} \;

# 向 crontab 注册 aria2b 定时重启任务（aria2b 长时间运行可能积压连接，定期重启保活）
# CRA2B=false 则移除已有任务；CRA2B 为数字小时数（1-24），其他值回退默认 2 小时
# aria2b v2.2.0 由 Node.js 启动，进程名不是 aria2b；直接通过 s6 v2 重启对应服务。
_register_a2b_restart() {
    local marker="restart-aria2b"
    # 无论如何先清除旧任务，避免重复
    crontab -l 2>/dev/null | grep -v "${marker}" | crontab -

    if [ "${CRA2B}" = "false" ]; then
        echo "CRA2B=false，已移除定时重启 aria2b 任务。"
        return 0
    fi

    # 提取 CRA2B 数字部分（如 "2h" -> "2"）；bash 原生参数扩展，免一次 fork
    local hours=${CRA2B//[!0-9]/}
    if [[ ! "${hours}" =~ ^([1-9]|1[0-9]|2[0-4])$ ]]; then
        hours=2
        echo "CRA2B 值无效，使用默认值 2 小时。"
    fi

    (crontab -l 2>/dev/null; echo "0 */${hours} * * * s6-svc -r /var/run/s6/services/aria2b # ${marker}") | crontab -
    echo "已设置定时重启任务：每 ${hours} 小时重启 aria2b 进程。"
}

# 同时检查环境开关和实际安装结果。standard 镜像即使被误设 A2B=true，
# 也不能注册一个指向不存在 s6 服务目录的定时任务。
if [ "${A2B}" = "true" ] && [ -x /usr/local/bin/aria2b ]; then
    _register_a2b_restart
fi
